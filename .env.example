# Copy this file to .env and fill in what you use. .env is gitignored.
# Variables already set in your shell take priority over this file.

# Vision model for --model comments and the capture hotkey:
# auto, claude-cli (your Claude Code login), anthropic, openai
HINGE_PROVIDER=claude-cli

# API keys, only needed for the anthropic or openai providers
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Model overrides
# HINGE_CLAUDE_CLI_MODEL=haiku
# HINGE_ANTHROPIC_MODEL=claude-opus-5
# HINGE_OPENAI_MODEL=gpt-5.4-mini

# Emulator
# HINGE_AVD=Medium_Phone_API_35
# HINGE_CONSOLE_PORT=5554
